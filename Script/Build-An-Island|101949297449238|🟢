local function getUpgradeNames()
    local player = game:GetService("Players").LocalPlayer
    local upgradePath = player.PlayerGui.Main.Menus.GoldUpgrades.Inner.ScrollingFrame.Hold
    local upgradeNames = {}
    
    local excludeNames = {
        "UIAspectRatioConstraint",
        "UIListLayout", 
        "UIPadding",
        "Example"
    }
    
    for _, child in pairs(upgradePath:GetChildren()) do
        local shouldExclude = false
        for _, excludeName in pairs(excludeNames) do
            if child.Name == excludeName then
                shouldExclude = true
                break
            end
        end
        
        if not shouldExclude then
            table.insert(upgradeNames, child.Name)
        end
    end
    
    return upgradeNames
end

local upgradeNames = getUpgradeNames()
local MultiDropdown = Tabs.Gameworks:AddDropdown("MultiDropdown", {
    Title = "Gold Upgrades", 
    Description = "Select upgrades to auto-purchase.", 
    Values = upgradeNames, 
    Multi = true, 
    Default = table.clone(upgradeNames),
})

MultiDropdown:OnChanged(function(Value)
    local Values = {}
    for Value, State in next, Value do
        if State then
            table.insert(Values, Value)
        end
    end
    getgenv().SelectedUpgrades = Values
end)

getgenv().SelectedUpgrades = upgradeNames

local function parseGoldAmount(text)
    if not text then return 0 end
    
    text = text:gsub("Gold", ""):gsub("%s+", "")
    
    local number = text:match("([%d%.]+)")
    if not number then return 0 end
    
    number = tonumber(number)
    if not number then return 0 end
    
    if text:lower():find("k") then
        number = number * 1000
    elseif text:lower():find("m") then
        number = number * 1000000
    elseif text:lower():find("b") then
        number = number * 1000000000
    end
    
    return math.floor(number)
end

local function getUpgradeCost(upgradeName)
    local player = game:GetService("Players").LocalPlayer
    local upgradeButton = player.PlayerGui.Main.Menus.GoldUpgrades.Inner.ScrollingFrame.Hold:FindFirstChild(upgradeName)
    
    if upgradeButton and upgradeButton:FindFirstChild("Button") and upgradeButton.Button:FindFirstChild("TextLabel") then
        local costText = upgradeButton.Button.TextLabel.Text
        return parseGoldAmount(costText)
    end
    
    return math.huge 
end

local function getCurrentGold()
    local player = game:GetService("Players").LocalPlayer
    if player.leaderstats and player.leaderstats:FindFirstChild("Gold") then
        return player.leaderstats.Gold.Value
    end
    return 0
end

local function findCheapestAffordableUpgrade()
    local currentGold = getCurrentGold()
    local cheapestUpgrade = nil
    local cheapestCost = math.huge
    
    for _, upgradeName in pairs(getgenv().SelectedUpgrades or {}) do
        local cost = getUpgradeCost(upgradeName)
        
        if cost <= currentGold and cost < cheapestCost then
            cheapestUpgrade = upgradeName
            cheapestCost = cost
        end
    end
    
    return cheapestUpgrade, cheapestCost
end

local Toggle = Tabs.Gameworks:AddToggle("DoGoldUpgradeAuto", {
    Title = "Auto Upgrade", 
    Default = false
})

Toggle:OnChanged(function()
    getgenv().AutoDoGoldUpgradeA = Options.DoGoldUpgradeAuto.Value

    if getgenv().AutoDoGoldUpgradeA then
        AutoDoGoldUpgradeALoop()
    else
        getgenv().AutoDoGoldUpgradeA = false
    end
end)

function AutoDoGoldUpgradeALoop()
    spawn(function()
        while getgenv().AutoDoGoldUpgradeA do 
            wait(0.1) 
            
            local upgradeToUse, cost = findCheapestAffordableUpgrade()
            
            if upgradeToUse then
                game:GetService("ReplicatedStorage").Communication.DoGoldUpgrade:FireServer(upgradeToUse)
                wait(0.5) 
            else
                wait(1)
            end
        end
    end)
end

