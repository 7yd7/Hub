getgenv().Tabs = nil
getgenv().Options = nil
getgenv().Window = nil
getgenv().Toggle = nil
getgenv().Value = nil

getgenv().GameName = "Regretevator"

if getgenv().Script then
    getgenv().Script = nil
end

getgenv().Script = function()
    function checkConcreteExists()
        if workspace.Elevator and workspace.Elevator.Ceiling and workspace.Elevator.Ceiling:FindFirstChild("Concrete") then
            return true
        else
            Fluent:Notify({
                Title = "7yd7 | Hub",
                Content = "Concrete ceiling not found in workspace.Elevator.Ceiling!",
                Duration = 8
            })
            return false
        end
    end
    
    function createAFKPart()
        if not checkConcreteExists() then
            return nil
        end
    
        if workspace:FindFirstChild("7yd7") then
            return workspace:FindFirstChild("7yd7")
        end
        
        local concrete = workspace.Elevator.Ceiling:FindFirstChild("Concrete")
        
        local afkPart = Instance.new("Part")
        afkPart.Name = "7yd7"
        afkPart.Size = Vector3.new(21.584325790405273, 7.663055896759033, 17.89038848876953)
        afkPart.Anchored = true
        afkPart.CanCollide = true
        
        local concretePosition = concrete.Position
        afkPart.Position = Vector3.new(concretePosition.X, concretePosition.Y + 5000, concretePosition.Z)
        
        afkPart.Parent = workspace
        
        return afkPart
    end
    
    function isPlayerAbovePart(player, part)
        if not player.Character then return false end
        
        local humanoidRootPart = player.Character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return false end
        
        local playerPos = humanoidRootPart.Position
        
        local partMin = Vector2.new(part.Position.X - (part.Size.X/2), part.Position.Z - (part.Size.Z/2))
        local partMax = Vector2.new(part.Position.X + (part.Size.X/2), part.Position.Z + (part.Size.Z/2))
        
        if playerPos.X >= partMin.X and playerPos.X <= partMax.X and
           playerPos.Z >= partMin.Y and playerPos.Z <= partMax.Y then
            
            local partTopY = part.Position.Y + (part.Size.Y/2)
            local distanceAbove = playerPos.Y - partTopY
            
            if distanceAbove >= -1 and distanceAbove <= 50 then
                return true
            end
        end
        
        return false
    end
    
    function returnToElevator()
        if not checkConcreteExists() then
            return
        end
    
        local player = game.Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
        
        local concrete = workspace.Elevator.Ceiling:FindFirstChild("Concrete")
        humanoidRootPart.CFrame = concrete.CFrame + Vector3.new(0, -10, 0)
    end
    
    function teleportToAFKPart()
        if not checkConcreteExists() then
            return
        end
    
        local player = game.Players.LocalPlayer
        local character = player.Character or player.CharacterAdded:Wait()
        local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
        
        local afkPart = createAFKPart()
        if afkPart then
            if not isPlayerAbovePart(player, afkPart) then
                humanoidRootPart.CFrame = afkPart.CFrame + Vector3.new(0, 10, 0) 
            end
        end
    end
    
    function startAFKLoop()
        if not checkConcreteExists() then
            return
        end
    
        spawn(function()
            while getgenv().AFK do
                teleportToAFKPart()
                wait(5) 
                
                if not getgenv().AFK then
                    break
                end
            end
        end)
    end
    
    local Toggle = Tabs.Gameworks:AddToggle("AFKValue", {Title = "AFK", Default = false})
    
    Toggle:OnChanged(function()
        if not checkConcreteExists() and Options.AFKValue.Value then
            Toggle:SetValue(false)
            return
        end
    
        getgenv().AFK = Options.AFKValue.Value
    
        if getgenv().AFK then
            startAFKLoop()
        else
            returnToElevator()
            getgenv().AFK = false
        end
    end)
    
    local AdvancedSection = Tabs.Gameworks:AddSection("Floors")
    
    
    getgenv().ObbyMonitor = false
    local selectedObbies = {}
    local monitoringActive = false
    
    local values = {
        "Intense Obby", "Rock Park", "Jeremy", "Fina The Path", "WALL OF", 
