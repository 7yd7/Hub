        ["Stanley Room"] = "StanelyRoom"
    }
    
    local obbyActions = {
        ["Intense Obby"] = function()
            firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, workspace.IntenseObby.ENDBLOCK, 0)
