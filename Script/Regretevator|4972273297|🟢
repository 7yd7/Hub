        ["Fun Flood At Squishy's"] = function()
            firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, workspace.FunTimesAtSquishyFlood.Build.Winparts:GetChildren()[4], 0)
            firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, workspace.FunTimesAtSquishyFlood.Build.Winparts:GetChildren()[3], 0)
            firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, workspace.FunTimesAtSquishyFlood.Build.Winparts:GetChildren()[2], 0)
