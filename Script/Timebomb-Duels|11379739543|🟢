local function getAllPlayerNames()
    local players = {"all"}
    for _, player in pairs(game.Players:GetPlayers()) do
        if player ~= localPlayer then
            table.insert(players, player.Name)
        end
    end
    return players
end

local JoinModeDropdown = Tabs.Gameworks:AddDropdown("JoinMode_Dropdown", {
    Title = "Join Mode",
    Values = {"infection", "team"},
    Multi = false,
    Default = 1,
})

local TargetPlayerDropdown = Tabs.Gameworks:AddDropdown("TargetPlayer_Dropdown", {
    Title = "Target Player",
    Values = getAllPlayerNames(),
    Multi = false,
    Default = 1,
})

local function updatePlayerDropdown()
    if not dropdownUpdateEnabled then return end
    
    local currentPlayerCount = #game.Players:GetPlayers()
    if currentPlayerCount ~= lastPlayerCount then
        local updatedPlayers = getAllPlayerNames()
        TargetPlayerDropdown:SetValues(updatedPlayers)
        lastPlayerCount = currentPlayerCount
    end
end

local function enableDropdownUpdates()
    dropdownUpdateEnabled = true
end

local function disableDropdownUpdates()
    dropdownUpdateEnabled = false
end

spawn(function()
    while true do
        wait(10)
        updatePlayerDropdown()
    end
end)

local playerAddedDebounce = false
local playerRemovedDebounce = false

game.Players.PlayerAdded:Connect(function()
    if playerAddedDebounce then return end
    playerAddedDebounce = true
    
    wait(2)
    updatePlayerDropdown()
    playerAddedDebounce = false
end)

game.Players.PlayerRemoving:Connect(function()
    if playerRemovedDebounce then return end
    playerRemovedDebounce = true
    
    wait(2)
    updatePlayerDropdown()
    playerRemovedDebounce = false
end)

