function isInGame()
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if playerGui and playerGui:FindFirstChild("TBDUI") and playerGui.TBDUI:FindFirstChild("Arena") and playerGui.TBDUI.Arena:FindFirstChild("Scorebar") then
        return playerGui.TBDUI.Arena.Scorebar.Visible
    end
    return false
end

function detectEnemyPlayers()
    local enemyPlayers = {}
    local localPlayerTeam = nil
    local currentArenaForLocalPlayer = nil 
    
    if workspace.Arenas then
        for arenaName, arena in pairs(workspace.Arenas:GetChildren()) do
            if arena:FindFirstChild("Slots") then
                if arena.Slots:FindFirstChild("Left") then
                    for i = 1, 4 do
                        local slot = arena.Slots.Left:FindFirstChild(tostring(i))
                        if slot and slot:FindFirstChild("Data") and slot.Data:FindFirstChild("Player") then
                            local player = slot.Data.Player.Value
                            if player == localPlayer then
                                localPlayerTeam = "Left"
                                currentArenaForLocalPlayer = arena 
                                break
                            end
                        end
                    end
                end
                
                if not currentArenaForLocalPlayer and arena.Slots:FindFirstChild("Right") then
                    for i = 1, 4 do
                        local slot = arena.Slots.Right:FindFirstChild(tostring(i))
                        if slot and slot:FindFirstChild("Data") and slot.Data:FindFirstChild("Player") then
                            local player = slot.Data.Player.Value
                            if player == localPlayer then
                                localPlayerTeam = "Right"
                                currentArenaForLocalPlayer = arena
                                break
                            end
                        end
                    end
                end
                
                if localPlayerTeam and currentArenaForLocalPlayer then 
                    local enemyTeam = (localPlayerTeam == "Left") and "Right" or "Left"
                    
                    if currentArenaForLocalPlayer.Slots:FindFirstChild(enemyTeam) then
                        for i = 1, 4 do
                            local slot = currentArenaForLocalPlayer.Slots[enemyTeam]:FindFirstChild(tostring(i))
                            if slot and slot:FindFirstChild("Data") and slot.Data:FindFirstChild("Player") then
                                local enemyPlayer = slot.Data.Player.Value
                                if enemyPlayer and enemyPlayer ~= localPlayer then
                                    table.insert(enemyPlayers, enemyPlayer)
                                end
                            end
                        end
                    end
                    break 
                end
            end
        end
    end
    
    return enemyPlayers, currentArenaForLocalPlayer 
end

function isPlayerOnArenaFloor(player, arena)
    if not player or not arena then
        return false
    end
    
    if arena:FindFirstChild("Slots") then
        for _, side in pairs({"Left", "Right"}) do
            if arena.Slots:FindFirstChild(side) then
                for i = 1, 4 do
                    local slot = arena.Slots[side]:FindFirstChild(tostring(i))
                    if slot and slot:FindFirstChild("Data") and slot.Data:FindFirstChild("Player") then
                        local slotPlayer = slot.Data.Player.Value
                        
                        if slotPlayer == player then
                            if slot:FindFirstChild("Pad") then
                                local pad = slot.Pad
                                local color = pad.Color
                                
                                if math.abs(color.R - 255/255) < 0.01 and 
                                   math.abs(color.G - 89/255) < 0.01 and 
                                   math.abs(color.B - 89/255) < 0.01 then
                                    return false 
                                else
                                    return true 
                                end
                            end
                            
                            return true
                        end
                    end
                end
            end
        end
    end
    
    return false
end

function findBombTool()
    local localCharacter = localPlayer.Character
    if localCharacter then
        local bombTool = localCharacter:FindFirstChild("Bomb")
        if bombTool then
            return bombTool, localCharacter
        end
        
        if localCharacter:FindFirstChild("Humanoid") then
            for _, tool in pairs(localCharacter:GetChildren()) do
                if tool:IsA("Tool") and tool.Name == "Bomb" then
                    return tool, localCharacter
                end
            end
        end
    end
    
    if workspace.Characters then
        local specificCharacter = workspace.Characters:FindFirstChild(localPlayer.Name)
        if specificCharacter then
            local bombTool = specificCharacter:FindFirstChild("Bomb")
            if bombTool then
                return bombTool, specificCharacter
            end
        end
    end
    
    return nil, nil
end

function isPlayerAliveInArena(player, arena)
    return isPlayerOnArenaFloor(player, arena)
end

function getPlayerStatusInArena(player, arena)
    if not player or not arena then
        return "not_found"
    end
    
    if arena:FindFirstChild("Slots") then
        for _, side in pairs({"Left", "Right"}) do
            if arena.Slots:FindFirstChild(side) then
                for i = 1, 4 do
                    local slot = arena.Slots[side]:FindFirstChild(tostring(i))
                    if slot and slot:FindFirstChild("Data") and slot.Data:FindFirstChild("Player") then
                        local slotPlayer = slot.Data.Player.Value
                        
                        if slotPlayer == player then
                            if slot:FindFirstChild("Pad") then
                                local pad = slot.Pad
                                local color = pad.Color
                                
                                if math.abs(color.R - 255/255) < 0.01 and 
                                   math.abs(color.G - 89/255) < 0.01 and 
                                   math.abs(color.B - 89/255) < 0.01 then
                                    return "dead" 
                                elseif math.abs(color.R - 87/255) < 0.01 and 
                                       math.abs(color.G - 181/255) < 0.01 and 
                                       math.abs(color.B - 57/255) < 0.01 then
                                    return "in_game" 
                                else
                                    return "alive"
                                end
                            end
                            return "alive" 
                        end
                    end
                end
            end
        end
    end
    
    return "not_found"
end

function isPlayerInsideHull(arena, side, slotNum)
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local slot = arena.Slots[side]:FindFirstChild(tostring(slotNum))
    if not slot or not slot:FindFirstChild("Hull") then
        return false
    end
    
    local hull = slot.Hull
    local playerPosition = character.HumanoidRootPart.Position
    local hullPosition = hull.Position
    local hullSize = hull.Size
    
    local distance = (playerPosition - hullPosition).Magnitude
    local maxDistance = math.max(hullSize.X, hullSize.Y, hullSize.Z) / 2 + 2
    
    return distance <= maxDistance
end


function teleportToWorldSpawn()
    local character = localPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") and workspace:FindFirstChild("WorldSpawn") then
        local humanoidRootPart = character.HumanoidRootPart
        local worldSpawn = workspace.WorldSpawn
        local distance = (humanoidRootPart.Position - worldSpawn.Position).Magnitude
        
        if distance > 10 then
            humanoidRootPart.CFrame = worldSpawn.CFrame
        end
    end
end

function checkForWalls(position, direction, maxDistance)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {localPlayer.Character}
    
    local raycast = workspace:Raycast(position, direction * maxDistance, raycastParams)
    if raycast then
        return math.max(1, raycast.Distance - 2) 
    end
    
    return math.max(1, maxDistance - 2) 
end

function isPositionInArena(position, arena)
    if not arena or not arena:FindFirstChild("Map") or not arena.Map:FindFirstChild("Floor") then
        return true
    end
    
    local floor = arena.Map.Floor
    local floorCFrame = floor.CFrame
    local floorSize = floor.Size
    local relativePos = floorCFrame:PointToObjectSpace(position)
    
    local padding = 4
    local withinX = math.abs(relativePos.X) <= (floorSize.X / 2) - padding
    local withinZ = math.abs(relativePos.Z) <= (floorSize.Z / 2) - padding
    
    local heightDiff = math.abs(position.Y - floor.Position.Y)
    local withinHeight = heightDiff < 50
    
    return withinX and withinZ and withinHeight
end

function findSafestPosition(currentPosition, enemies)
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return currentPosition
    end
    
    local humanoidRootPart = character.HumanoidRootPart
    local bestPosition = currentPosition
    local maxSafeDistance = 0
    
    local directions = {
        Vector3.new(1, 0, 0),  
        Vector3.new(-1, 0, 0),  
        Vector3.new(0, 0, 1),  
        Vector3.new(0, 0, -1), 
        Vector3.new(1, 0, 1).Unit,  
        Vector3.new(-1, 0, 1).Unit,  
        Vector3.new(1, 0, -1).Unit,  
        Vector3.new(-1, 0, -1).Unit 
    }
    
    for _, direction in pairs(directions) do
        local testDistance = 15
        local wallDistance = checkForWalls(currentPosition, direction, testDistance)
        local actualDistance = math.min(testDistance, wallDistance - 2)
        
        if actualDistance > 3 then
            local testPosition = currentPosition + (direction * actualDistance)
            local minEnemyDistance = math.huge
            
            for _, enemy in pairs(enemies) do
                if enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
                    local enemyPos = enemy.Character.HumanoidRootPart.Position
                    local distance = (testPosition - enemyPos).Magnitude
                    minEnemyDistance = math.min(minEnemyDistance, distance)
                end
            end
            
            if minEnemyDistance > maxSafeDistance then
                maxSafeDistance = minEnemyDistance
                bestPosition = testPosition
            end
        end
    end
    
    return bestPosition
end

function hasEnemyBomb(enemy)
    if enemy.Character then
        local bombTool = enemy.Character:FindFirstChild("Bomb")
        if bombTool then
            return true
        end
        
        for _, tool in pairs(enemy.Character:GetChildren()) do
            if tool:IsA("Tool") and tool.Name == "Bomb" then
                return true
            end
        end
    end
    return false
end

function checkPathClear(startPos, endPos)
    local direction = (endPos - startPos)
    local distance = direction.Magnitude
    
    if distance < 1 then
        return true, endPos
    end
    
    direction = direction.Unit
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {localPlayer.Character}
    
    local raycast = workspace:Raycast(startPos, direction * distance, raycastParams)
    if raycast then
        if raycast.Distance < distance - 2 then
            local safeDistance = math.max(1, raycast.Distance - 3)
            local safePos = startPos + (direction * safeDistance)
            return false, safePos
        end
    end
    
    return true, endPos
end

function getEnemiesWithBombs(enemies)
    local enemiesWithBombs = {}
    for _, enemy in pairs(enemies) do
        if hasEnemyBomb(enemy) then
            table.insert(enemiesWithBombs, enemy)
        end
    end
    return enemiesWithBombs
end

function findUltimateEscapePosition(currentPosition, primaryEnemy, allEnemies, arena)
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return currentPosition
    end
    
    local primaryEnemyPos = primaryEnemy.Character.HumanoidRootPart.Position
    local primaryDistance = (currentPosition - primaryEnemyPos).Magnitude
    
    if primaryDistance < 8 then
        local emergencyDirection = (currentPosition - primaryEnemyPos).Unit
        
        for testDist = 15, 5, -2 do
            local emergencyPos = currentPosition + (emergencyDirection * testDist)
            local pathClear, actualPos = checkPathClear(currentPosition, emergencyPos)
            
            if pathClear and isPositionInArena(emergencyPos, arena) then
                return emergencyPos
            elseif actualPos then
                local safePos = currentPosition + (emergencyDirection * (testDist - 3))
                if isPositionInArena(safePos, arena) then
                    return safePos
                end
            end
        end
    end
    
    local bestPosition = currentPosition
    local maxSafetyScore = 0
    
    local directions = {}
    for angle = 0, 315, 30 do
        local rad = math.rad(angle)
        table.insert(directions, Vector3.new(math.cos(rad), 0, math.sin(rad)))
    end
    
    for _, direction in pairs(directions) do
        for testDistance = 6, 25, 3 do
            local testPosition = currentPosition + (direction * testDistance)
            
            local pathClear, blockedAt = checkPathClear(currentPosition, testPosition)
            
            if not pathClear then
                if blockedAt then
                    local safeDistance = (blockedAt - currentPosition).Magnitude
                    if safeDistance > 3 then
                        testPosition = blockedAt
                        testDistance = safeDistance
                    else
                        break
                    end
                else
                    break
                end
            end
            
            if not isPositionInArena(testPosition, arena) then
                break
            end
            
            local safetyScore = 0
            local minEnemyDistance = math.huge
            
            for _, enemy in pairs(allEnemies) do
                if enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
                    local enemyPos = enemy.Character.HumanoidRootPart.Position
                    local distanceToEnemy = (testPosition - enemyPos).Magnitude
                    
                    minEnemyDistance = math.min(minEnemyDistance, distanceToEnemy)
                    
                    if enemy == primaryEnemy then
                        safetyScore = safetyScore + (distanceToEnemy * 3)
                    else
                        safetyScore = safetyScore + (distanceToEnemy * 1.5)
                    end
                end
            end
            
            if minEnemyDistance > 12 and minEnemyDistance < 30 then
                safetyScore = safetyScore + 25
            end
            
            if pathClear then
                safetyScore = safetyScore + 15
            end
            
            if testDistance > 8 and testDistance < 20 then
                safetyScore = safetyScore + 10
            end
            
            if safetyScore > maxSafetyScore then
                maxSafetyScore = safetyScore
                bestPosition = testPosition
            end
        end
    end
    
    local finalCheck, _ = checkPathClear(currentPosition, bestPosition)
    if not finalCheck then
        local fallbackDirection = (bestPosition - currentPosition).Unit
        for dist = 5, 15, 2 do
            local fallbackPos = currentPosition + (fallbackDirection * dist)
            local fallbackCheck, _ = checkPathClear(currentPosition, fallbackPos)
            if fallbackCheck and isPositionInArena(fallbackPos, arena) then
                return fallbackPos
            end
        end
        return currentPosition
    end
    
    return bestPosition
end

function startEvasionLoop()
    spawn(function()
        local lastEvasionTime = 0
        local emergencyMode = false
        local lastKnownEnemyPositions = {}
        
        while getgenv().SmartEvasion do
            wait(0.01) 
            
            if not isInGame() then
                wait(0.01) 
                continue
            end
            
            local character = localPlayer.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then
                wait(0.01)
                continue
            end
            
            local humanoidRootPart = character.HumanoidRootPart
            local currentPosition = humanoidRootPart.Position
            local currentTime = tick()
            
            local enemies, currentArena = detectEnemyPlayers()
            local enemiesWithBombs = getEnemiesWithBombs(enemies)
            
            if #enemiesWithBombs > 0 and not isUsingBomb then
                local mostDangerousEnemy = nil
                local closestDistance = math.huge
                local highestThreat = 0
                
                for _, enemy in pairs(enemiesWithBombs) do
                    if enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
                        local enemyPos = enemy.Character.HumanoidRootPart.Position
                        local distance = (currentPosition - enemyPos).Magnitude
                        
                        local enemyVelocity = Vector3.new(0, 0, 0)
                        if lastKnownEnemyPositions[enemy.UserId] then
                            local lastPos = lastKnownEnemyPositions[enemy.UserId].position
                            local timeDiff = currentTime - lastKnownEnemyPositions[enemy.UserId].time
                            if timeDiff > 0 then
                                enemyVelocity = (enemyPos - lastPos) / timeDiff
                            end
                        end
                        
                        lastKnownEnemyPositions[enemy.UserId] = {
                            position = enemyPos,
                            time = currentTime
                        }
                        
                        local speed = enemyVelocity.Magnitude
                        local directionToMe = (currentPosition - enemyPos).Unit
                        local enemyDirection = enemyVelocity.Unit
                        
                        local threatLevel = 0
                        
                        if distance < 40 then
                            threatLevel = threatLevel + (40 - distance) * 2
                        end
                        
                        if speed > 16 then 
                            threatLevel = threatLevel + speed * 1.5
                        end
                        
                        if speed > 5 then
                            local dotProduct = enemyDirection:Dot(directionToMe)
                            if dotProduct > 0.7 then
                                threatLevel = threatLevel + 50
                                emergencyMode = true
                            elseif dotProduct > 0.3 then 
                                threatLevel = threatLevel + 25
                            end
                        end
                        
                        if threatLevel > highestThreat or (threatLevel > 20 and distance < closestDistance) then
                            mostDangerousEnemy = enemy
                            highestThreat = threatLevel
                            closestDistance = distance
                        end
                    end
                end
                
                if mostDangerousEnemy and (highestThreat > 15 or emergencyMode) then
                    local safePosition = findUltimateEscapePosition(currentPosition, mostDangerousEnemy, enemiesWithBombs, currentArena)
                    
                    if safePosition and (safePosition - currentPosition).Magnitude > 1 then
                        local escapeDirection = (safePosition - currentPosition).Unit
                        humanoidRootPart.CFrame = CFrame.new(safePosition, safePosition + escapeDirection)
                        
                        lastEvasionTime = currentTime
                        
                        if emergencyMode then
                            wait(0.01) 
                            emergencyMode = false
                        end
                    end
                end
            else
                emergencyMode = false
                lastKnownEnemyPositions = {}
            end
        end
    end)
end

function isPlayerInArena()
    if workspace.Arenas then
        for _, arena in pairs(workspace.Arenas:GetChildren()) do
            if arena:FindFirstChild("Slots") then
                for _, side in pairs({"Left", "Right"}) do
                    if arena.Slots:FindFirstChild(side) then
                        for i = 1, 4 do
                            local slot = arena.Slots[side]:FindFirstChild(tostring(i))
                            if slot and slot:FindFirstChild("Data") and slot.Data:FindFirstChild("Player") then
                                if slot.Data.Player.Value == localPlayer then
                                    return true, arena, side, i
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

function checkPlayerArenaStatus()
    if workspace.Arenas then
        for _, arena in pairs(workspace.Arenas:GetChildren()) do
            if arena:FindFirstChild("Slots") then
                for _, side in pairs({"Left", "Right"}) do
                    if arena.Slots:FindFirstChild(side) then
                        for i = 1, 4 do
                            local slot = arena.Slots[side]:FindFirstChild(tostring(i))
                            if slot and slot:FindFirstChild("Data") and slot.Data:FindFirstChild("Player") then
                                if slot.Data.Player.Value == localPlayer then
                                    local isInside = isPlayerInsideHull(arena, side, i)
                                    return true, arena, side, i, isInside
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return false, nil, nil, nil, false
end

function autoFixPosition(arena, side, slotNum)
    
    teleportToWorldSpawn()
    wait(0.5) 
    return joinArenaSlot(arena, side, slotNum)
end

function quickEnemyCheck()
    local enemies, arena = detectEnemyPlayers()
    if not arena then return nil end
    
    for _, enemy in pairs(enemies) do
        if enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") and isPlayerOnArenaFloor(enemy, arena) then
            return enemy
        end
    end
    return nil
end

function instantTeleportToEnemy(targetEnemy)
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    if not targetEnemy.Character or not targetEnemy.Character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local humanoidRootPart = character.HumanoidRootPart
    local targetRootPart = targetEnemy.Character.HumanoidRootPart
    
    if not originalPosition then
        originalPosition = humanoidRootPart.CFrame
    end
    
    local behindPosition = targetRootPart.CFrame * CFrame.new(-1, 0, 2.5)
    humanoidRootPart.CFrame = behindPosition
    
    return true
end

function isSlotInGame(arena, side, slotNum)
    local slot = arena.Slots[side]:FindFirstChild(tostring(slotNum))
    if slot and slot:FindFirstChild("Pad") then
        local pad = slot.Pad
        local color = pad.Color
        if math.abs(color.R - 87/255) < 0.01 and 
           math.abs(color.G - 181/255) < 0.01 and 
           math.abs(color.B - 57/255) < 0.01 then
            return true
        end
    end
    return false
end

function isAnyPlayerInGameInArena(arena)
    if not arena or not arena:FindFirstChild("Slots") then
        return false
    end
    
    for _, side in pairs({"Left", "Right"}) do
        if arena.Slots:FindFirstChild(side) then
            for i = 1, 4 do
                if isSlotInGame(arena, side, i) then
                    return true
                end
            end
        end
    end
    
    return false
end

function isReadyPromptVisible()
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if playerGui and playerGui:FindFirstChild("TBDUI") and playerGui.TBDUI:FindFirstChild("Arena") 
    and playerGui.TBDUI.Arena:FindFirstChild("Prompts") and playerGui.TBDUI.Arena.Prompts:FindFirstChild("Ready") then
        return playerGui.TBDUI.Arena.Prompts.Ready.Visible, playerGui.TBDUI.Arena.Prompts.Ready
    end
    return false, nil
end

function fireReadyRemote()
    local remoteStorage = game:GetService("ReplicatedStorage")
    if remoteStorage:FindFirstChild("Remotes") and remoteStorage.Remotes:FindFirstChild("Arena") 
    and remoteStorage.Remotes.Arena:FindFirstChild("Ready") then
        remoteStorage.Remotes.Arena.Ready:FireServer(true)
    end
end

function findTargetPlayer(targetName)
    if targetName == "all" then
        return nil
    end
    
    for _, player in pairs(game.Players:GetPlayers()) do
        if player.Name == targetName and player ~= localPlayer then
            return player
        end
    end
    return nil
end

function findFirstAvailableSlot(arena, side, excludeSlot)
    if not arena or not arena.Slots or not arena.Slots:FindFirstChild(side) then
        return nil
    end
    
    for i = 1, 4 do
        if i ~= excludeSlot then
            local slot = arena.Slots[side]:FindFirstChild(tostring(i))
            if slot and slot:FindFirstChild("Data") and slot.Data:FindFirstChild("Player") then
                if slot.Data.Player.Value == nil and not isSlotInGame(arena, side, i) then
                    return i
                end
            end
        end
    end
    
    return nil
end

function findPlayerInArenas(targetPlayer)
    if workspace.Arenas then
        local availablePlayers = {}
        
        for _, arena in pairs(workspace.Arenas:GetChildren()) do
            if arena:FindFirstChild("Slots") then
                if isAnyPlayerInGameInArena(arena) then
                    continue
                end
                
                for _, side in pairs({"Left", "Right"}) do
                    if arena.Slots:FindFirstChild(side) then
                        for i = 1, 4 do
                            local slot = arena.Slots[side]:FindFirstChild(tostring(i))
                            if slot and slot:FindFirstChild("Data") and slot.Data:FindFirstChild("Player") then
                                local player = slot.Data.Player.Value
                                if player and player ~= localPlayer and player.Parent and not isSlotInGame(arena, side, i) then
                                    local hasAvailableSlot = false
                                    
                                    if getgenv().JoinMode == "infection" then
                                        local oppositeSide = (side == "Left") and "Right" or "Left"
                                        if findFirstAvailableSlot(arena, oppositeSide, nil) then
                                            hasAvailableSlot = true
                                        end
                                    elseif getgenv().JoinMode == "team" then
                                        if findFirstAvailableSlot(arena, side, i) then
                                            hasAvailableSlot = true
                                        end
                                    end
                                    
                                    if hasAvailableSlot then
                                        if targetPlayer == nil then
                                            table.insert(availablePlayers, {
                                                arena = arena,
                                                side = side,
                                                slot = i,
                                                player = player
                                            })
                                        elseif player == targetPlayer then
                                            return arena, side, i, player
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        
        if targetPlayer == nil and #availablePlayers > 0 then
            local selected = availablePlayers[1]
            return selected.arena, selected.side, selected.slot, selected.player
        end
    end
    return nil
end

function checkIfStillWithPlayer(currentArena, currentSide, currentSlot, targetPlayer)
    if not currentArena or not currentSide or not currentSlot then
        return false
    end
    
    local targetSide = currentSide
    local searchSlots = {}
    
    if getgenv().JoinMode == "infection" then
        targetSide = (currentSide == "Left") and "Right" or "Left"
    end
    
    if getgenv().JoinMode == "team" then
        for i = 1, 4 do
            table.insert(searchSlots, i)
        end
    else
        table.insert(searchSlots, currentSlot)
    end
    
    for _, slotNum in pairs(searchSlots) do
        local slot = currentArena.Slots[targetSide]:FindFirstChild(tostring(slotNum))
        if slot and slot:FindFirstChild("Data") and slot.Data:FindFirstChild("Player") then
            local player = slot.Data.Player.Value
            if player == targetPlayer then
                return true
            end
        end
    end
    
    return false
end

function joinArenaSlot(arena, targetSide, targetSlot)
    if not arena.Slots[targetSide]:FindFirstChild(tostring(targetSlot)) or 
       not arena.Slots[targetSide][tostring(targetSlot)]:FindFirstChild("Hull") then
        return false
    end
    
    local arenaKey = tostring(arena) .. "_" .. targetSide .. "_" .. targetSlot
    local currentTime = tick()
    
    if joinCooldown[arenaKey] and (currentTime - joinCooldown[arenaKey]) < 2 then
        return false
    end
    
    local currentPosition = arena.Slots[targetSide][tostring(targetSlot)].Hull.Position
    if lastJoinPosition and (lastJoinPosition - currentPosition).Magnitude > 10 then
        joinAttempts = {}
    end
    lastJoinPosition = currentPosition
    
    if not joinAttempts[arenaKey] then
        joinAttempts[arenaKey] = 0
    end
    
    if joinAttempts[arenaKey] >= maxJoinAttempts then
        teleportToWorldSpawn()
        joinAttempts[arenaKey] = 0 
        joinCooldown[arenaKey] = currentTime
        return false
    end
    
    local hull = arena.Slots[targetSide][tostring(targetSlot)].Hull
    local character = localPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        joinAttempts[arenaKey] = joinAttempts[arenaKey] + 1
        
        character.HumanoidRootPart.CFrame = hull.CFrame * CFrame.new(0, -5, 0)
        
        wait(0.3)
        
        if isPlayerInsideHull(arena, targetSide, targetSlot) then
            joinAttempts[arenaKey] = 0 
            return true
        else
            return false
        end
    end
    return false
end

function findBestSlot(arena, foundSide, foundSlot, foundPlayer)
    if isAnyPlayerInGameInArena(arena) then
        return nil, nil
    end
    
    local targetSide = foundSide
    local targetSlot = foundSlot
    
    if getgenv().JoinMode == "infection" then
        targetSide = (foundSide == "Left") and "Right" or "Left"
        targetSlot = foundSlot
    elseif getgenv().JoinMode == "team" then
        targetSide = foundSide
        targetSlot = nil
        
        for i = 1, 4 do
            if i ~= foundSlot then
                local slot = arena.Slots[targetSide]:FindFirstChild(tostring(i))
                if slot and slot:FindFirstChild("Data") and slot.Data:FindFirstChild("Player") then
                    if slot.Data.Player.Value == nil and not isSlotInGame(arena, targetSide, i) then
                        targetSlot = i
                        break
                    end
                end
            end
        end
        
        if targetSlot == nil then
            return nil, nil
        end
    end
    
    return targetSide, targetSlot
end

function startAutoJoinLoop()
    spawn(function()
        local lastJoinedArena = nil
        local lastJoinedSide = nil
        local lastJoinedSlot = nil
        local lastTargetPlayer = nil
        
        while getgenv().AutoJoin do
            wait(0.1) 

            if isInGame() then
                wait(0.3)
                continue
            end
            
            local isInArena, currentArena, currentSide, currentSlot, isInsideHull = checkPlayerArenaStatus()
            
            if isInArena then
                if not isInsideHull then
                    if autoFixPosition(currentArena, currentSide, currentSlot) then
                    else
                        teleportToWorldSpawn()
                    end
                    wait(1)
                    continue
                end
                
                local playersInCurrentArena = {}
                if currentArena and currentArena:FindFirstChild("Slots") then
                    for _, side in pairs({"Left", "Right"}) do
                        if currentArena.Slots:FindFirstChild(side) then
                            for i = 1, 4 do
                                local slot = currentArena.Slots[side]:FindFirstChild(tostring(i))
                                if slot and slot:FindFirstChild("Data") and slot.Data:FindFirstChild("Player") and slot.Data.Player.Value then
                                    local player = slot.Data.Player.Value
                                    if player ~= localPlayer and player.Parent and not isSlotInGame(currentArena, side, i) then
                                        table.insert(playersInCurrentArena, player)
                                    end
                                end
                            end
                        end
                    end
                end

                if #playersInCurrentArena == 0 then
                    teleportToWorldSpawn()
                    wait(0.2)
                    continue
                end

                local readyVisible, readyPrompt = isReadyPromptVisible()
                if readyVisible and readyPrompt and readyPrompt.Text == "Ready" then
                    fireReadyRemote()
                end
                wait(0.1)
                continue
            end
            
            local foundArena, foundSide, foundSlot, foundPlayer
            if getgenv().TargetPlayer == "all" then
                foundArena, foundSide, foundSlot, foundPlayer = findPlayerInArenas(nil)
            else
                local targetPlayer = findTargetPlayer(getgenv().TargetPlayer)
                if targetPlayer and targetPlayer.Parent then 
                    foundArena, foundSide, foundSlot, foundPlayer = findPlayerInArenas(targetPlayer)
                end
            end
            
            if foundArena and foundSide and foundSlot then
                local targetSide, targetSlot = findBestSlot(foundArena, foundSide, foundSlot, foundPlayer)
                
                if not targetSide or not targetSlot then
                    wait(.1)
                    continue
                end
                
                local targetSlotObj = foundArena.Slots[targetSide]:FindFirstChild(tostring(targetSlot))
                if targetSlotObj and targetSlotObj:FindFirstChild("Data") and targetSlotObj.Data:FindFirstChild("Player") then
                    if targetSlotObj.Data.Player.Value == nil and not isSlotInGame(foundArena, targetSide, targetSlot) then
                        if not isAnyPlayerInGameInArena(foundArena) then
                            if joinArenaSlot(foundArena, targetSide, targetSlot) then
                                lastJoinedArena = foundArena
                                lastJoinedSide = targetSide
                                lastJoinedSlot = targetSlot
                                lastTargetPlayer = foundPlayer
                                
                                wait(0.1)  
                                
                                local readyVisible, readyPrompt = isReadyPromptVisible()
                                if readyVisible and readyPrompt and readyPrompt.Text == "Ready" then
                                    fireReadyRemote()
                                end
                            end
                        end
                    end
                end
            else
                wait(0.2) 
            end
        end
    end)
end

spawn(function()
    while true do
        wait(60) 
        local currentTime = tick()
        
        for key, time in pairs(joinCooldown) do
            if (currentTime - time) > 300 then  
                joinCooldown[key] = nil
            end
        end
        if #joinAttempts > 50 then
            joinAttempts = {}
        end
    end
end)


local originalPosition = nil
local isUsingBomb = false
local lastEnemyPosition = nil
local enemyVelocity = Vector3.new(0, 0, 0)
local bombLoop = nil

function useBombOnEnemy(bombTool, character, targetEnemy)
    if bombLoop or not bombTool or not character or not targetEnemy or not targetEnemy.Character then
        return false
    end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    local targetRootPart = targetEnemy.Character:FindFirstChild("HumanoidRootPart")
    
    if not humanoidRootPart or not targetRootPart then
        return false
    end
    
    if not isUsingBomb then
        originalPosition = humanoidRootPart.CFrame
        isUsingBomb = true
    end
    
    local behindPosition = targetRootPart.CFrame * CFrame.new(-2, 0, 4)
    humanoidRootPart.CFrame = behindPosition
    
    bombLoop = spawn(function()
        local bombActivated = false
        local maxAttempts = 100 
        local attempts = 0
        
        while getgenv().EnemyDetection and character:FindFirstChild("Bomb") and attempts < maxAttempts do
            attempts = attempts + 1
            wait(0.01) 
            
            local currentBomb = character:FindFirstChild("Bomb")
            if not currentBomb or not targetRootPart or not humanoidRootPart then
                break
            end
            
            local currentEnemyPosition = targetRootPart.Position
            if lastEnemyPosition then
                enemyVelocity = (currentEnemyPosition - lastEnemyPosition) / 0.01 
            end
            lastEnemyPosition = currentEnemyPosition
            
            local speed = enemyVelocity.Magnitude
            local distance = 2 
            local leftOffset = -1
            
            if speed > 8 then
                distance = 3
                leftOffset = -0.5
            elseif speed < 1 then
                distance = 1.5
                leftOffset = -0.8
            else
                distance = 2
                leftOffset = -1
            end
            
            local predictedPosition = currentEnemyPosition
            if speed > 1 then
                local forwardVelocity = Vector3.new(enemyVelocity.X, 0, enemyVelocity.Z)
                local enemyLookVector = targetRootPart.CFrame.LookVector
                local movementDirection = forwardVelocity.Unit
                local dotProduct = enemyLookVector:Dot(movementDirection)
                
                if dotProduct > -0.5 then
                    predictedPosition = currentEnemyPosition + (forwardVelocity * 0.15) 
                end
            end
            
            local predictedCFrame = CFrame.new(predictedPosition, predictedPosition + targetRootPart.CFrame.LookVector)
            local smartBehindPosition = predictedCFrame * CFrame.new(leftOffset, 0, distance)
            
            humanoidRootPart.CFrame = smartBehindPosition
            
            if not bombActivated then
                bombActivated = true
                wait(0.01) 
                break
            end
        end
        
        lastEnemyPosition = nil
        enemyVelocity = Vector3.new(0, 0, 0)
        bombLoop = nil
        
        if getgenv().AFKMode then
            teleportToWorldSpawn()
        elseif originalPosition and humanoidRootPart then
            humanoidRootPart.CFrame = originalPosition
        end
        
        originalPosition = nil
        isUsingBomb = false
    end)
    
    return true
end

function isPlayerAlive(player)
    if player and player.Character and player.Character:FindFirstChild("Humanoid") then
        local humanoid = player.Character.Humanoid
        if humanoid.Health > 0 then
            return true
        end
    end
    return false
end

function startEnemyDetectionLoop()
    spawn(function()
        while getgenv().EnemyDetection do
            wait(.01) 
            
            if not isInGame() then
                wait(0.1)
                continue
            end
            
            local enemies, arenaOfLocalPlayer = detectEnemyPlayers()
            
            local validEnemies = {}
            if arenaOfLocalPlayer then
                for _, enemy in pairs(enemies) do
                    if isPlayerAlive(enemy) and isPlayerOnArenaFloor(enemy, arenaOfLocalPlayer) then
                        table.insert(validEnemies, enemy)
                    end
                end
            end

            if #validEnemies > 0 and not isUsingBomb then
                local firstValidEnemy = validEnemies[1]
                local bombTool, character = findBombTool()
                
                if bombTool and character then
                    useBombOnEnemy(bombTool, character, firstValidEnemy)
                else
                    if getgenv().AFKMode then
                        teleportToWorldSpawn()
                    end
                end
            elseif #validEnemies == 0 then
                if isUsingBomb and originalPosition then
                    local character = localPlayer.Character
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        if getgenv().AFKMode then
                            teleportToWorldSpawn()
                        else
                            character.HumanoidRootPart.CFrame = originalPosition
                        end
                        originalPosition = nil
                        isUsingBomb = false
                        if bombLoop then
                            bombLoop = nil
                        end
                    end
                end
            end
        end
    end)
end

Tabs.Gameworks:AddSection("More")

local Toggle = Tabs.Gameworks:AddToggle("Bomb_Resize", {Title = "Bomb Resize", Default = false})

Toggle:OnChanged(function()
    getgenv().BombResize = Options.Bomb_Resize.Value

    if getgenv().BombResize then
        startBombLoop()
    else
        getgenv().BombResize = false
    end
end)

function startBombLoop()
    spawn(function()
        while getgenv().BombResize do
            task.wait(.2)

            local Players = game:GetService("Players")
            local LocalPlayer = Players.LocalPlayer

            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character then
                    local tool = player.Character:FindFirstChildOfClass("Tool")
                    if tool then
                        for _, part in pairs(tool:GetDescendants()) do
                            if part:IsA("BasePart") then
                                if player == LocalPlayer then
                                    part.Size = Vector3.new(10, 10, 10) 
                                else
                                    part.Size = Vector3.new(2, 2, 2) 
                                end
                                part.Massless = true
                                part.CanCollide = false
                            end
                        end
                    end
                end
            end
        end
    end)
end


end

